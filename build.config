### Target Vendor/Product (support only Ralink RT3883/MT7620/MT7621)
CONFIG_VENDOR=ASUS
CONFIG_PRODUCT=RT3052

### Target ProductID (board select, max 23 ASCII symbols)
CONFIG_FIRMWARE_PRODUCT_ID="RT-N10C1"

############################################################
### Linux kernel configuration
############################################################

### Разгон процессора до 600 МГц (переопределяет настройки загрузчика)
### Внимание: актуально только для чипов MT7620, на RT5350 не сработает
#CONFIG_FIRMWARE_CPU_600MHZ=y

### Режим сна процессора (снижение частоты до 200 МГц при простое)
### Внимание: тоже только для архитектуры MT7620
#CONFIG_FIRMWARE_CPU_SLEEP=y

### Версия закрытого драйвера Wi-Fi от MediaTek для диапазона 2.4 ГГц
### 2.7 = старая версия (v2.7.2.0)
### 3.0 = более современная и стабильная версия (v3.0.4.0)
CONFIG_FIRMWARE_WIFI2_DRIVER=3.0

### Включить поддержку протокола IPv6 в ядре и системе
CONFIG_FIRMWARE_ENABLE_IPV6=y

### Базовая поддержка USB-контроллера
#CONFIG_FIRMWARE_ENABLE_USB=y

### Файловые системы для USB-накопителей:
### FAT/FAT32 (занимает ~0.1MB)
#CONFIG_FIRMWARE_ENABLE_FAT=y
### exFAT (включает в себя FAT/FAT32) (~0.12MB)
#CONFIG_FIRMWARE_ENABLE_EXFAT=y
### Linux EXT2 (~0.1MB)
#CONFIG_FIRMWARE_ENABLE_EXT2=y
### Linux EXT3 (~0.2MB)
#CONFIG_FIRMWARE_ENABLE_EXT3=y
### Linux EXT4 (включает в себя EXT2 и EXT3) (~0.4MB)
#CONFIG_FIRMWARE_ENABLE_EXT4=y
### Высокопроизводительная XFS (~0.6MB)
#CONFIG_FIRMWARE_ENABLE_XFS=y
### Apple HFS+ (~0.1MB)
#CONFIG_FIRMWARE_ENABLE_HFS=y

### Поддержка FUSE (виртуальные файловые системы в пространстве пользователя).
#CONFIG_FIRMWARE_ENABLE_FUSE=y

### Поддержка файлов и разделов подкачки (SWAP). Полезно при нехватке RAM. ~0.05MB
#CONFIG_FIRMWARE_ENABLE_SWAP=y

### Драйверы для USB веб-камер (UVC). ~0.2MB
#CONFIG_FIRMWARE_INCLUDE_UVC=y

### Драйверы для USB-устройств ввода (клавиатуры, мыши). ~0.2MB
#CONFIG_FIRMWARE_INCLUDE_HID=y

### Драйверы для переходников USB-UART (например, чип pl2303). ~0.03MB
#CONFIG_FIRMWARE_INCLUDE_SERIAL=y

### Фреймворк ядра XFRM и расширение iptables для IPsec (аппаратное шифрование VPN). ~0.2MB
#CONFIG_FIRMWARE_INCLUDE_XFRM=y

### Модули планировщика QoS (для шейпинга и ограничения скорости клиентов). ~0.2MB
#CONFIG_FIRMWARE_INCLUDE_QOS=y

### Устаревший модуль IMQ для шейпинга (может снижать общую производительность сети). ~0.02MB
#CONFIG_FIRMWARE_INCLUDE_IMQ=y

### Современный модуль IFB для шейпинга и управления входящим трафиком. ~0.03MB
#CONFIG_FIRMWARE_INCLUDE_IFB=y

### Утилита IPSet: позволяет iptables мгновенно проверять огромные списки IP-адресов
### (критически важно для скриптов обхода блокировок и анти-DDoS). ~0.4MB
CONFIG_FIRMWARE_INCLUDE_IPSET=y

### Сервер NFSv3 (для создания сетевой папки / NAS). ~0.6MB
#CONFIG_FIRMWARE_INCLUDE_NFSD=y

### Клиент NFSv3 (чтобы роутер сам мог подключаться к чужим сетевым папкам). ~0.5MB
#CONFIG_FIRMWARE_INCLUDE_NFSC=y

### Клиент CIFS / SMB (подключение роутера к сетевым папкам Windows). ~0.2MB
#CONFIG_FIRMWARE_INCLUDE_CIFS=y

### Аппаратное ускорение маршрутизации (Fast Path / SFE)
### Направляет трафик в обход центрального процессора, сильно повышает скорость интернета
CONFIG_FIRMWARE_INCLUDE_SHORTCUT_FE=y

### Включить сборку бэкпортированных (адаптированных из новых ядер) драйверов для медиаустройств
#CONFIG_FIRMWARE_ENABLE_BACKPORTED=y
### Встроить эти бэкпортированные драйверы прямо в образ прошивки 
### (иначе они соберутся в отдельный архив для установки на флешку в /opt/lib/)
#CONFIG_FIRMWARE_INCLUDE_BACKPORTED=y

############################################################
### Userspace configuration
############################################################

### Языковые пакеты веб-интерфейса (сильно увеличивают размер прошивки)
### Русский (RU) занимает около 40 КБ.
#CONFIG_FIRMWARE_INCLUDE_LANG_BR=y
#CONFIG_FIRMWARE_INCLUDE_LANG_CN=y
#CONFIG_FIRMWARE_INCLUDE_LANG_CZ=y
#CONFIG_FIRMWARE_INCLUDE_LANG_DA=y
#CONFIG_FIRMWARE_INCLUDE_LANG_DE=y
#CONFIG_FIRMWARE_INCLUDE_LANG_ES=y
#CONFIG_FIRMWARE_INCLUDE_LANG_FI=y
#CONFIG_FIRMWARE_INCLUDE_LANG_FR=y
#CONFIG_FIRMWARE_INCLUDE_LANG_NO=y
#CONFIG_FIRMWARE_INCLUDE_LANG_PL=y
CONFIG_FIRMWARE_INCLUDE_LANG_RU=y
#CONFIG_FIRMWARE_INCLUDE_LANG_SV=y
#CONFIG_FIRMWARE_INCLUDE_LANG_UK=y

### Полноценный FUSE-драйвер NTFS-3G для записи на диски Windows (вместо закрытого ufsd). ~0.4MB
#CONFIG_FIRMWARE_INCLUDE_NTFS_3G=y

### Демон LPR-принтера (расшаривание обычного USB-принтера по сети). ~0.12MB
#CONFIG_FIRMWARE_INCLUDE_LPRD=y

### Проприетарный принт-сервер ASUS/Eltima USB-over-Ethernet. ~0.05MB
#CONFIG_FIRMWARE_INCLUDE_U2EC=y

### Демон USB-over-IP (проброс любого USB-устройства по сети так, будто оно вставлено в ПК). ~0.05MB
#CONFIG_FIRMWARE_INCLUDE_USBIP=y

### Утилита "tcpdump" (сниффер для перехвата и анализа сетевого трафика). ~0.6MB
#CONFIG_FIRMWARE_INCLUDE_TCPDUMP=y

### Утилита "socat" (мощный инструмент для перенаправления портов и потоков данных). ~0.3MB
#CONFIG_FIRMWARE_INCLUDE_SOCAT=y

### Утилиты "ndisc6" и "rdisc6" (инструменты диагностики для IPv6). ~0.27MB
#CONFIG_FIRMWARE_INCLUDE_NDISC6_RDISC6=y

### Утилита "hdparm" (управление жесткими дисками: настройка APM и времени остановки шпинделя). ~0.1MB
#CONFIG_FIRMWARE_INCLUDE_HDPARM=y

### Утилита "parted" (работа с GPT-разметкой дисков, создание разделов). ~0.3MB
#CONFIG_FIRMWARE_INCLUDE_PARTED=y

### Файловый сервер Samba / SMB (и сервер WINS) для сетевых папок. ~1.5MB
#CONFIG_FIRMWARE_INCLUDE_SMBD=y
### Включить только WINS-сервер (разрешение имен компьютеров в сети). ~0.4MB
#CONFIG_FIRMWARE_INCLUDE_WINS=y
### Системный журнал (syslog) для SMB и WINS. ~0.3MB
#CONFIG_FIRMWARE_INCLUDE_SMBD_SYSLOG=y
### Утилита testparm для проверки конфигурации Samba. ~0.2MB
#CONFIG_FIRMWARE_INCLUDE_TESTPARM=y

### FTP-сервер для доступа к файлам. ~0.2MB
#CONFIG_FIRMWARE_INCLUDE_FTPD=y
### Включить шифрование (SSL) для FTP-сервера
#CONFIG_FIRMWARE_INCLUDE_FTPD_SSL=y

### Include alternative L2TP control client RP-L2TP
#CONFIG_FIRMWARE_INCLUDE_RPL2TP=y

### Поддержка корпоративной аутентификации 802.1x (EAP-TTLS и EAP-PEAP).
### Требует openssl (~1.2MB), wpa_supplicant (+0.04MB)
#CONFIG_FIRMWARE_INCLUDE_EAP_PEAP=y

### Поддержка HTTPS для клиента динамического DNS (DDNS). Требует openssl (~1.2MB)
#CONFIG_FIRMWARE_INCLUDE_DDNS_SSL=y

### Поддержка HTTPS для доступа к веб-интерфейсу самого роутера. Требует openssl (~1.2MB)
#CONFIG_FIRMWARE_INCLUDE_HTTPS=y

### Сервер SFTP (защищенная передача файлов по SSH). Требует openssl (~1.2MB) и sftp-server (~0.06MB)
#CONFIG_FIRMWARE_INCLUDE_SFTP=y

### Легкий SSH-сервер Dropbear для доступа в консоль. ~0.3MB
#CONFIG_FIRMWARE_INCLUDE_DROPBEAR=y
### Ускорение симметричных шифров и хэшей для Dropbear (увеличивает размер на ~0.06MB)
#CONFIG_FIRMWARE_INCLUDE_DROPBEAR_FAST_CODE=y

### Использовать "тяжелый" OpenSSH вместо Dropbear. Требует openssl (~1.2MB) и сам весит ~1.0MB
#CONFIG_FIRMWARE_INCLUDE_OPENSSH=y

### Клиент/Сервер OpenVPN (требует IPv6, openssl ~1.2MB, openvpn ~0.4MB)
#CONFIG_FIRMWARE_INCLUDE_OPENVPN=y

### Клиент/Сервер StrongSwan для IPsec VPN (требует XFRM ~0.2MB, strongswan ~0.7MB)
#CONFIG_FIRMWARE_INCLUDE_SSWAN=y

### Модуль ядра и утилита WireGuard (быстрый современный VPN)
#CONFIG_FIRMWARE_INCLUDE_WIREGUARD=y

### Модуль ядра AmneziaWG (форк WireGuard с защитой от блокировок по DPI-сигнатурам)
#CONFIG_FIRMWARE_INCLUDE_AMNEZIAWG=y

### Добавить поддержку эллиптических кривых (EC) в библиотеку openssl. ~0.1MB
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_EC=y

### Исполняемый файл "openssl" для генерации сертификатов прямо на роутере. ~0.4MB
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_EXE=y

### Медиасервер xUPNPd (трансляция плейлистов IPTV на Smart TV). ~0.3MB
#CONFIG_FIRMWARE_INCLUDE_XUPNPD=y

### Медиасервер Minidlna (трансляция видео/музыки с жесткого диска на Smart TV). ~1.6MB
#CONFIG_FIRMWARE_INCLUDE_MINIDLNA=y

### Торрент-качалка Transmission. Требует openssl (~1.2MB), transmission ~1.5MB
#CONFIG_FIRMWARE_INCLUDE_TRANSMISSION=y
### Продвинутый веб-интерфейс для Transmission (Transmission-Web-Control). ~0.8MB
#CONFIG_FIRMWARE_INCLUDE_TRANSMISSION_WEB_CONTROL=y

### Менеджер загрузок Aria2 (качает по HTTP, FTP, BitTorrent). Требует openssl (~1.2MB), aria2 ~3.5MB
#CONFIG_FIRMWARE_INCLUDE_ARIA=y

### Include Aria2 WEB control. ~0.7MB
#CONFIG_FIRMWARE_INCLUDE_ARIA_WEB_CONTROL=y

### Клиент луковой сети TOR. Очень тяжелый: ~2.8MB
#CONFIG_FIRMWARE_INCLUDE_TOR=y
### Базы GeoIP (привязка IP к странам) для TOR. ~0.7MB
#CONFIG_FIRMWARE_INCLUDE_TOR_GEOIP=y
### Базы GeoIP IPv6 для TOR. ~0.6MB
#CONFIG_FIRMWARE_INCLUDE_TOR_GEOIPV6=y

### Прокси-сервер Privoxy (часто работает в связке с Tor для фильтрации рекламы). ~0.3MB
#CONFIG_FIRMWARE_INCLUDE_PRIVOXY=y

### Прокси DNSCrypt (шифрование DNS-запросов, скрывает посещаемые сайты от провайдера). ~0.5MB
#CONFIG_FIRMWARE_INCLUDE_DNSCRYPT=y

### Утилита Stubby для протокола DNS-over-TLS (DoT). ~0.5MB
#CONFIG_FIRMWARE_INCLUDE_STUBBY=y

### Прокси doh_proxy для протокола DNS-over-HTTPS (DoH). ~0.4MB
#CONFIG_FIRMWARE_INCLUDE_DOH=y

### Утилита Curl (мощный инструмент для скачивания файлов и запросов из командной строки). ~0.15MB
#CONFIG_FIRMWARE_INCLUDE_CURL=y

### Поддержка современного протокола QUIC (HTTP/3) в Curl. Требует openssl 3.5. ~0.4 MB
#CONFIG_FIRMWARE_INCLUDE_QUIC=y
### Альтернативная библиотека ngtcp2 для QUIC в Curl. Требует openssl 3.5. ~0.5 MB
#CONFIG_FIRMWARE_INCLUDE_QUIC_NGTCP2=y

### Выбор версии библиотеки шифрования openssl (по умолчанию используется 3.0)
### Устаревшая, но легкая версия 1.0.2u
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_10=y
### Стабильная версия 1.1.1w
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_11=y
### Новейшая версия 3.5
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_35=y

### Поддержка протокола WPAD (автоматическое обнаружение настроек прокси для браузеров)
#CONFIG_FIRMWARE_INCLUDE_WPAD=y

### Поддержка ZRAM (виртуальный диск в оперативной памяти с аппаратным сжатием, спасает при малом объеме RAM)
#CONFIG_FIRMWARE_INCLUDE_ZRAM=y

### Утилита ADB (Android Debug Bridge) для управления Android-смартфонами по USB
#CONFIG_FIRMWARE_INCLUDE_ADB=y

### Поддержка скриптового языка LUA (часто нужен для кастомных скриптов управления). ~0.2MB
#CONFIG_FIRMWARE_INCLUDE_LUA=y

### Туннели EoIP (Ethernet over IP). Объединение удаленных сетей на уровне L2 (как в MikroTik). ~0.01MB
#CONFIG_FIRMWARE_INCLUDE_EOIP=y

### Эмулятор KMS-сервера vlmcsd (автоматическая активация Windows/Office в локальной сети). ~0.06MB
#CONFIG_FIRMWARE_INCLUDE_VLMCSD=y

### Утилита iPerf3 для точного тестирования скорости и пропускной способности сети. ~0.13MB
#CONFIG_FIRMWARE_INCLUDE_IPERF3=y

### Утилита NFQWS (инструмент для модификации пакетов на лету, обход систем DPI и блокировок). ~0.1MB
#CONFIG_FIRMWARE_INCLUDE_NFQWS=y

### Команда компилятору максимально сжимать бинарный код (-Os), чтобы уменьшить размер прошивки (TRX)
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
