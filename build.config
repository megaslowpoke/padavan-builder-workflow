### Целевой производитель и платформа (в комментарии шаблона указаны только Ralink RT3883/MT7620/MT7621)
CONFIG_VENDOR=DLINK
CONFIG_PRODUCT=RT3052

### Идентификатор целевого устройства ProductID (выбор профиля платы, максимум 23 ASCII-символа)
CONFIG_FIRMWARE_PRODUCT_ID="DIR-300B1"

############################################################
### Конфигурация ядра Linux
############################################################

### Принудительно установить частоту процессора MT7620 на 600 МГц (переопределяет настройки загрузчика U-Boot)
#CONFIG_FIRMWARE_CPU_600MHZ=y

### Включить энергосберегающий режим процессора MT7620 (снижение частоты до 200 МГц в простое)
#CONFIG_FIRMWARE_CPU_SLEEP=y

### Выбор версии драйвера ядра для точки доступа Wi-Fi 2.4 ГГц
### 2.7 = MT7620 v2.7.2.0
### 3.0 = MT7620 v3.0.4.0
CONFIG_FIRMWARE_WIFI2_DRIVER=2.7

### Включить поддержку протокола IPv6
CONFIG_FIRMWARE_ENABLE_IPV6=y

### Включить поддержку шины USB
#CONFIG_FIRMWARE_ENABLE_USB=y

### Включить поддержку файловых систем FAT/FAT32. ~0.1 МБ
#CONFIG_FIRMWARE_ENABLE_FAT=y

### Включить поддержку файловой системы exFAT (включая FAT/FAT32). ~0.12 МБ
#CONFIG_FIRMWARE_ENABLE_EXFAT=y

### Включить поддержку файловой системы EXT2. ~0.1 МБ
#CONFIG_FIRMWARE_ENABLE_EXT2=y

### Включить поддержку файловой системы EXT3. ~0.2 МБ
#CONFIG_FIRMWARE_ENABLE_EXT3=y

### Включить поддержку файловой системы EXT4 (включая EXT3 и EXT2). ~0.4 МБ
#CONFIG_FIRMWARE_ENABLE_EXT4=y

### Включить поддержку файловой системы XFS. ~0.6 МБ
#CONFIG_FIRMWARE_ENABLE_XFS=y

### Включить поддержку файловой системы Apple HFS+. ~0.1 МБ
#CONFIG_FIRMWARE_ENABLE_HFS=y

### Включить поддержку FUSE (работа с файловыми системами в пользовательском пространстве). ~0.1 МБ
#CONFIG_FIRMWARE_ENABLE_FUSE=y

### Включить поддержку файлов и разделов подкачки (swap). ~0.05 МБ
#CONFIG_FIRMWARE_ENABLE_SWAP=y

### Включить модули ядра для UVC-камер (USB веб-камер). ~0.2 МБ
#CONFIG_FIRMWARE_INCLUDE_UVC=y

### Включить модули USB-HID (устройства ввода, ИБП с USB-интерфейсом). ~0.2 МБ
#CONFIG_FIRMWARE_INCLUDE_HID=y

### Включить модули USB-Serial переходников (например, pl2303). ~0.03 МБ
#CONFIG_FIRMWARE_INCLUDE_SERIAL=y

### Включить модули шифрования XFRM (IPsec) и соответствующие расширения iptables. ~0.2 МБ
#CONFIG_FIRMWARE_INCLUDE_XFRM=y

### Включить модули планировщика приоритетов сетевого трафика (QoS). ~0.2 МБ
#CONFIG_FIRMWARE_INCLUDE_QOS=y

### Включить модуль виртуального интерфейса IMQ для шейперов трафика (немного снижает производительность сети). ~0.02 МБ
#CONFIG_FIRMWARE_INCLUDE_IMQ=y

### Включить модуль виртуального интерфейса IFB для шейперов трафика. ~0.03 МБ
#CONFIG_FIRMWARE_INCLUDE_IFB=y

### Включить утилиту IPSet и модули ядра для работы со списками IP-адресов. ~0.4 МБ
CONFIG_FIRMWARE_INCLUDE_IPSET=y

### Включить сервер сетевой файловой системы NFSv3. ~0.6 МБ
#CONFIG_FIRMWARE_INCLUDE_NFSD=y

### Включить клиент сетевой файловой системы NFSv3. ~0.5 МБ
#CONFIG_FIRMWARE_INCLUDE_NFSC=y

### Включить клиент сетевых папок CIFS (SMB). ~0.2 МБ
#CONFIG_FIRMWARE_INCLUDE_CIFS=y

### Включить программный ускоритель маршрутизации Shortcut Forward Engine (SFE)
CONFIG_FIRMWARE_INCLUDE_SHORTCUT_FE=y

############################################################
### Конфигурация пользовательского пространства (программы и службы)
############################################################

### Включить языковые пакеты для веб-интерфейса (увеличивает размер прошивки)
#CONFIG_FIRMWARE_INCLUDE_LANG_BR=y
#CONFIG_FIRMWARE_INCLUDE_LANG_CN=y
#CONFIG_FIRMWARE_INCLUDE_LANG_CZ=y
#CONFIG_FIRMWARE_INCLUDE_LANG_DA=y
#CONFIG_FIRMWARE_INCLUDE_LANG_DE=y
#CONFIG_FIRMWARE_INCLUDE_LANG_ES=y
#CONFIG_FIRMWARE_INCLUDE_LANG_FI=y
#CONFIG_FIRMWARE_INCLUDE_LANG_FR=y
#CONFIG_FIRMWARE_INCLUDE_LANG_NO=y
#CONFIG_FIRMWARE_INCLUDE_LANG_PL=y
CONFIG_FIRMWARE_INCLUDE_LANG_RU=y
#CONFIG_FIRMWARE_INCLUDE_LANG_SV=y
#CONFIG_FIRMWARE_INCLUDE_LANG_UK=y

### Включить открытый драйвер NTFS-3G на базе FUSE (вместо проприетарного драйвера Paragon "ufsd"). ~0.4 МБ
#CONFIG_FIRMWARE_INCLUDE_NTFS_3G=y

### Включить службу сервера печати LPR. ~0.12 МБ
#CONFIG_FIRMWARE_INCLUDE_LPRD=y

### Включить службу сервера печати ASUS/Eltima USB-over-Ethernet. ~0.05 МБ
#CONFIG_FIRMWARE_INCLUDE_U2EC=y

### Включить службу проброса USB по сети (USB-over-IP). ~0.05 МБ
#CONFIG_FIRMWARE_INCLUDE_USBIP=y

### Включить утилиту перехвата и анализа сетевых пакетов "tcpdump". ~0.6 МБ
#CONFIG_FIRMWARE_INCLUDE_TCPDUMP=y

### Включить утилиту для работы с сетевыми сокетами и потоками "socat". ~0.3 МБ
#CONFIG_FIRMWARE_INCLUDE_SOCAT=y

### Включить сетевые утилиты IPv6 "ndisc6" и "rdisc6". ~0.27 МБ
#CONFIG_FIRMWARE_INCLUDE_NDISC6_RDISC6=y

### Включить утилиту "hdparm" (позволяет настраивать время остановки диска и управление питанием APM). ~0.1 МБ
#CONFIG_FIRMWARE_INCLUDE_HDPARM=y

### Включить утилиту разметки дисков "parted" (позволяет создавать разделы GPT). ~0.3 МБ
#CONFIG_FIRMWARE_INCLUDE_PARTED=y

### Включить файловый сервер SMB (Samba) вместе с сервером имен WINS. ~1.5 МБ
#CONFIG_FIRMWARE_INCLUDE_SMBD=y

### Включить только сервер имен WINS (без файлового сервера SMB). ~0.4 МБ
#CONFIG_FIRMWARE_INCLUDE_WINS=y

### Включить подробное логирование (syslog) для серверов SMB и WINS. ~0.3 МБ
#CONFIG_FIRMWARE_INCLUDE_SMBD_SYSLOG=y

### Включить утилиту проверки конфига "testparm" для сервера SMB. ~0.2 МБ
#CONFIG_FIRMWARE_INCLUDE_TESTPARM=y

### Включить FTP-сервер (и опционально поддержку шифрования SSL для него). ~0.2 МБ
#CONFIG_FIRMWARE_INCLUDE_FTPD=y
#CONFIG_FIRMWARE_INCLUDE_FTPD_SSL=y

### Включить поддержку авторизации EAP-TTLS и EAP-PEAP (Wi-Fi Enterprise / провайдерские сети 802.1X). Требует openssl (~1.2 МБ), wpa_supplicant (+0.04 МБ)
#CONFIG_FIRMWARE_INCLUDE_EAP_PEAP=y

### Включить поддержку HTTPS для клиента динамического DNS (DDNS). Требует openssl (~1.2 МБ)
#CONFIG_FIRMWARE_INCLUDE_DDNS_SSL=y

### Включить поддержку HTTPS (для веб-интерфейса роутера). Требует openssl (~1.2 МБ)
#CONFIG_FIRMWARE_INCLUDE_HTTPS=y

### Включить сервер SFTP (передача файлов по SSH). Требует openssl (~1.2 МБ), сам sftp-server (~0.06 МБ)
#CONFIG_FIRMWARE_INCLUDE_SFTP=y

### Включить легковесный SSH-сервер и клиент Dropbear. ~0.3 МБ
#CONFIG_FIRMWARE_INCLUDE_DROPBEAR=y

### Ускорить работу симметричных шифров и хешей в Dropbear (немного увеличивает размер кода). ~0.06 МБ
#CONFIG_FIRMWARE_INCLUDE_DROPBEAR_FAST_CODE=y

### Включить полноценный пакет OpenSSH вместо легковесного Dropbear. Требует openssl (~1.2 МБ), сам openssh (~1.0 МБ)
#CONFIG_FIRMWARE_INCLUDE_OPENSSH=y

### Включить клиент и сервер OpenVPN (требуется включенный IPv6). Требует openssl (~1.2 МБ), сам openvpn (~0.4 МБ)
#CONFIG_FIRMWARE_INCLUDE_OPENVPN=y

### Включить IPsec-пакет StrongSwan. Модули ядра XFRM (~0.2 МБ), сам strongswan (~0.7 МБ)
#CONFIG_FIRMWARE_INCLUDE_SSWAN=y

### Включить модуль ядра и утилиту управления VPN WireGuard
#CONFIG_FIRMWARE_INCLUDE_WIREGUARD=y

### Включить модуль ядра AmneziaWG (модификация WireGuard с защитой от блокировок DPI)
#CONFIG_FIRMWARE_INCLUDE_AMNEZIAWG=y

### Включить поддержку алгоритмов эллиптических кривых (EC) в библиотеку openssl. ~0.1 МБ
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_EC=y

### Включить консольную утилиту "openssl" для генерации сертификатов на роутере. ~0.4 МБ
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_EXE=y

### Включить IPTV-медиасервер xUPNPd (трансляция мультикаст/IPTV-плейлистов по DLNA). ~0.3 МБ
#CONFIG_FIRMWARE_INCLUDE_XUPNPD=y

### Включить домашний UPnP/DLNA-медиасервер MiniDLNA. ~1.6 МБ
#CONFIG_FIRMWARE_INCLUDE_MINIDLNA=y

### Включить торрент-клиент Transmission. Требует openssl (~1.2 МБ), сам transmission (~1.5 МБ)
#CONFIG_FIRMWARE_INCLUDE_TRANSMISSION=y

### Включить расширенный веб-интерфейс Transmission-Web-Control. ~0.8 МБ
#CONFIG_FIRMWARE_INCLUDE_TRANSMISSION_WEB_CONTROL=y

### Включить консольный менеджер загрузок Aria2. Требует openssl (~1.2 МБ), сама aria2 (~3.5 МБ)
#CONFIG_FIRMWARE_INCLUDE_ARIA=y

### Включить луковый прокси-маршрутизатор TOR. ~2.8 МБ
#CONFIG_FIRMWARE_INCLUDE_TOR=y

### Включить базу географической привязки IP-адресов GeoIP (IPv4) для TOR. ~0.7 МБ
#CONFIG_FIRMWARE_INCLUDE_TOR_GEOIP=y

### Включить базу географической привязки GeoIP (IPv6) для TOR. ~0.6 МБ
#CONFIG_FIRMWARE_INCLUDE_TOR_GEOIPV6=y

### Включить фильтрующий HTTP-прокси Privoxy. ~0.3 МБ
#CONFIG_FIRMWARE_INCLUDE_PRIVOXY=y

### Включить прокси шифрования DNS-запросов DNSCrypt. ~0.5 МБ
#CONFIG_FIRMWARE_INCLUDE_DNSCRYPT=y

### Включить клиент Stubby для работы с DNS-over-TLS (DoT). ~0.5 МБ
#CONFIG_FIRMWARE_INCLUDE_STUBBY=y

### Включить прокси doh_proxy для работы с DNS-over-HTTPS (DoH). ~0.4 МБ
#CONFIG_FIRMWARE_INCLUDE_DOH=y

### Включить утилиту и библиотеку для передачи данных cURL. ~0.15 МБ
#CONFIG_FIRMWARE_INCLUDE_CURL=y

### Включить поддержку протокола QUIC (HTTP/3) в cURL (требуется openssl 3.5). ~0.4 МБ
#CONFIG_FIRMWARE_INCLUDE_QUIC=y

### Включить поддержку протокола QUIC в cURL на базе библиотеки ngtcp2 (требуется openssl 3.5). ~0.5 МБ
#CONFIG_FIRMWARE_INCLUDE_QUIC_NGTCP2=y

### Использовать альтернативную версию библиотеки openssl вместо стандартной 3.0
### openssl 1.0.2u
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_10=y
### openssl 1.1.1w
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_11=y
### openssl 3.5
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_35=y

### Включить полноценный пакет wpad (для поддержки роуминга 802.11k/v/r и Mesh)
#CONFIG_FIRMWARE_INCLUDE_WPAD=y

### Включить поддержку сжатия данных в оперативной памяти (модуль zRAM)
#CONFIG_FIRMWARE_INCLUDE_ZRAM=y

### Добавить пакет ADB (Android Debug Bridge, обычно нужен для управления USB-модемами на базе Android)
#CONFIG_FIRMWARE_INCLUDE_ADB=y

### Включить поддержку интерпретатора языка сценариев Lua. ~0.2 МБ
#CONFIG_FIRMWARE_INCLUDE_LUA=y

### Включить поддержку туннелирования EoIP (Ethernet over IP, протокол совместимый с MikroTik). ~0.01 МБ
#CONFIG_FIRMWARE_INCLUDE_EOIP=y

### Включить эмулятор сервера KMS-активации (vlmcsd). ~0.06 МБ
#CONFIG_FIRMWARE_INCLUDE_VLMCSD=y

### Включить утилиту замера пропускной способности сети iPerf3. ~0.13 МБ
#CONFIG_FIRMWARE_INCLUDE_IPERF3=y

### Включить утилиту модификации пакетов NFQWS (компонент запрета/обхода DPI). ~0.1 МБ
#CONFIG_FIRMWARE_INCLUDE_NFQWS=y

### Уменьшить размер итогового образа прошивки (.trx) за счет агрессивной оптимизации компилятора по размеру кода
#CONFIG_CC_OPTIMIZE_FOR_SIZE=y
